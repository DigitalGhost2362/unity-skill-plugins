{
  "description": "Inject the Unity skill index into sessions that start inside a Unity project.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
